<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <!-- 窗口背景 = 品牌启动画面（v6：PageBackground 同款渐变底 + 渐变圆角容器 + 白音符 + 品牌名，方形圆角不被圆形遮罩裁切）：零额外停留 -->
        <item name="android:windowBackground">@drawable/splashscreen_brand_window</item>
    </style>

    <!-- Splash screen：API<31 无系统 splash，窗口背景即启动画面（渐变底 + 图标）
         API 31+ 的系统 splash 属性在 values-v31/styles.xml 中覆盖（纯色 + 圆形品牌底 + 白音符，规避圆形裁切） -->
    <style name="Theme.App.SplashScreen" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@drawable/splashscreen_brand_window</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>