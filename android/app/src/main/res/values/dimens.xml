<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 启动页音符容器尺寸（正方形，=屏短边×42%，按 sw 档位分档接近自适应）
         splash_note_icon = 容器×78%（音符视觉占容器约 78%）
         splash_note_corner = 容器×22%（圆角） -->
    <dimen name="splash_note_container">160dp</dimen>
    <dimen name="splash_note_icon">125dp</dimen>
    <dimen name="splash_note_corner">35dp</dimen>
    <!-- 品牌名"极悦界"文字图（透明底）：宽=容器×55%（约合 RN 短边×0.32 clamp 120~220），高=宽/3（原图 1200×400）
         顶偏移 = 容器 + 2×16gap + 文字高，配合 layer gravity="center" 使文字中心落在"容器下缘+16dp 空隙"处 -->
    <dimen name="splash_brand_text_width">88dp</dimen>
    <dimen name="splash_brand_text_height">29.3dp</dimen>
    <dimen name="splash_brand_text_top">221.3dp</dimen>
</resources>
