<?xml version="1.0" encoding="utf-8"?>
<!-- 启动页音符容器：圆角矩形 + 渐变（同桌面图标 #4055D4→#B7CDFE，135° 左上→右下） -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/splash_note_corner" />
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#4055D4"
        android:endColor="#B7CDFE" />
</shape>
