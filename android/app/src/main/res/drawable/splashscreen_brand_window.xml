<?xml version="1.0" encoding="utf-8"?>
<!-- 窗口背景 = 品牌启动画面：浅蓝纯色底 + 品牌图标（方形圆角透明底，完整不被圆形遮罩裁切）
     对齐网易云/QQ音乐实测：品牌图放 windowBackground，窗口一创建立即全屏显示，零额外停留。
     API<31：窗口背景即启动画面（纯色底 + 图标）；
     API 31+：系统 splash（纯色+隐形图标，见 values-v31）退出后，窗口背景同色底 + 完整图标承接，
     直到 bootstrap 完成渲染主界面——品牌可感知且不拖慢启动（图标属背景层，无任何等待）。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F1F4FA" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/splashscreen_icon"
            android:gravity="center"
            android:scaleType="fitCenter" />
    </item>
</layer-list>
