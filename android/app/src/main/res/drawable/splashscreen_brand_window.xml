<?xml version="1.0" encoding="utf-8"?>
<!-- 窗口背景 = 品牌启动画面（v2 视觉：渐变背景 + 圆角渐变容器 + 白色音符）：
     层1 背景：从下(#EAF0FA 微品牌蓝) → 上(#F8F9FA 白) 线性渐变（angle=90，与软件内部 PageBackground 同款渐变）
     层2 容器：圆角矩形，135° 渐变 #4055D4→#B7CDFE（同桌面图标），边长=屏短边×42%（dimens 分档）
     层3 音符：白色音符图（音符≈100% 画布），边长=容器×78%，fitCenter 等比
     与 RN BrandSplash（同渐变背景 + 同容器 + 音符 + 主题色文字）两段无缝。
     API<31：窗口背景即启动画面；API 31+：系统 splash（白色+隐形图标，见 values-v31）退出后由本背景承接。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="90"
                android:startColor="#EAF0FA"
                android:endColor="#F8F9FA" />
        </shape>
    </item>
    <item
        android:width="@dimen/splash_note_container"
        android:height="@dimen/splash_note_container"
        android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/splash_note_corner" />
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#4055D4"
                android:endColor="#B7CDFE" />
        </shape>
    </item>
    <item
        android:width="@dimen/splash_note_icon"
        android:height="@dimen/splash_note_icon"
        android:gravity="center">
        <!-- 音符图已为"音符≈100% 画布"，fitCenter 于 item 内 → 音符=容器×78% -->
        <bitmap
            android:src="@drawable/splashscreen_icon"
            android:scaleType="fitCenter" />
    </item>
</layer-list>
