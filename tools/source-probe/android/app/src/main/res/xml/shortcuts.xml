<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面快捷方式（App Shortcuts，Android 7.1+）：长按桌面图标弹出快捷操作。
     点击后以 SHORTCUT action + shortcut_action extra 拉起 MainActivity，
     MainActivity 解析并转发给 RN（事件 + pending 兜底）。不启用固定快捷方式。 -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="play"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_play"
        android:shortcutLongLabel="@string/shortcut_play">
        <intent
            android:action="fun.upup.sourceprobe.SHORTCUT"
            android:targetPackage="fun.upup.sourceprobe"
            android:targetClass="fun.upup.sourceprobe.MainActivity">
            <extra
                android:name="shortcut_action"
                android:value="play" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="local"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_local"
        android:shortcutLongLabel="@string/shortcut_local">
        <intent
            android:action="fun.upup.sourceprobe.SHORTCUT"
            android:targetPackage="fun.upup.sourceprobe"
            android:targetClass="fun.upup.sourceprobe.MainActivity">
            <extra
                android:name="shortcut_action"
                android:value="local" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_search"
        android:shortcutLongLabel="@string/shortcut_search">
        <intent
            android:action="fun.upup.sourceprobe.SHORTCUT"
            android:targetPackage="fun.upup.sourceprobe"
            android:targetClass="fun.upup.sourceprobe.MainActivity">
            <extra
                android:name="shortcut_action"
                android:value="search" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="update"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_update"
        android:shortcutLongLabel="@string/shortcut_update">
        <intent
            android:action="fun.upup.sourceprobe.SHORTCUT"
            android:targetPackage="fun.upup.sourceprobe"
            android:targetClass="fun.upup.sourceprobe.MainActivity">
            <extra
                android:name="shortcut_action"
                android:value="update" />
        </intent>
    </shortcut>
</shortcuts>
